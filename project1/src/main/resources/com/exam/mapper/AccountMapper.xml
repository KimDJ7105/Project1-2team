<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.mapper.AccountMapper">

    <!-- 계좌 조회 -->
    <select id="findAccount" resultType="AccountDTO" parameterType="int">
        select * from account
        where user_id = #{userId}
    </select>


</mapper>
